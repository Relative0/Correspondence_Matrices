+def test_recorder_exclusive_partition_and_failure():
+    wall, cpu = iter([0,10,30,50]), iter([0,2,6,10])
+    trace = PhaseRecorder(wall_clock=lambda: next(wall), cpu_clock=lambda: next(cpu))
