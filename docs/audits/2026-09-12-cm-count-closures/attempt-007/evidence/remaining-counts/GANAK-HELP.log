Usage: ganak [--help] [--verb VAR] [--seed VAR] [--version] [--mode VAR] [--prime VAR] [--npolyvars VAR] [--delta VAR] [--appmct VAR] [--epsilon VAR] [--chronobt VAR] [--prob VAR] [--fast] [--compile VAR] [--arjun VAR] [--arjunverb VAR] [--arjungates VAR] [--arjunextend VAR] [--prebackbone VAR] [--puura VAR] [--puurabackbone VAR] [--puurabackbonemaxconfl VAR] [--puuraautarky VAR] [--arjuniter1 VAR] [--arjuniter2 VAR] [--arjunprobe VAR] [--arjunsimplev VAR] [--arjunbackwmaxc VAR] [--arjunoraclefindbins VAR] [--arjunoraclemult VAR] [--puuraoraclevivif VAR] [--puuraoraclesparsify VAR] [--puurabve VAR] [--bveresolvmaxsz VAR] [--bvegrowiter1 VAR] [--bvegrowiter2 VAR] [--extraoracle VAR] [--resolvsub VAR] [--arjunoraclegetlearnt VAR] [--arjundebugcnf VAR] [--arjuncmsmult VAR] [--arjunsamplcutoff VAR] [--arjunextendccnr VAR] [--arjunweakenlim VAR] [--puurastrategy VAR] [--td VAR] [--tdmaxw VAR] [--tdminw VAR] [--tddiv VAR] [--tdexpmult VAR] [--tdcheckagainstind VAR] [--tditers VAR] [--tdsteps VAR] [--tdlook VAR] [--tdlooktwcut VAR] [--tdlookiters VAR] [--tdcontract VAR] [--tdlimit VAR] [--tdoptindep VAR] [--tdmaxdensity VAR] [--tdmaxedgeratio VAR] [--tduseadj VAR] [--tdreadfile VAR] [--tdvis VAR] [--tddumpcnf VAR] [--rdbclstarget VAR] [--rdbeveryn VAR] [--rdbkeepused VAR] [--consolidateeveryn VAR] [--lbd VAR] [--updatelbdcutoff VAR] [--polar VAR] [--decide VAR] [--initact VAR] [--vsadsadjust VAR] [--actscorediv VAR] [--freqscorediv VAR] [--cache VAR] [--maxcache VAR] [--cachetime VAR] [--lru VAR] [--buddy VAR] [--buddymaxcls VAR] [--shrink VAR] [--bumpreason VAR] [--vivif VAR] [--vivifevery VAR] [--vivifmult VAR] [--vivifoutern VAR] [--totusedcutoffvivif VAR] [--sbvasteps VAR] [--sbvaclcut VAR] [--sbvalitcut VAR] [--sbvabreak VAR] [--sbvamaxnewvars VAR] [--satsolver VAR] [--satrst VAR] [--satrstmult VAR] [--satpolarcache VAR] [--satvsids VAR] [--allindep VAR] [--arjunextendmaxconfl VAR] [--arjunextend VAR] [--stripoptindep VAR] [--analyzecand VAR] [--rstfirst VAR] [--restart VAR] [--rsttype VAR] [--rstcheckcnt VAR] [--rstreadjust VAR] [--maxrst VAR] [--maxcubesperrst VAR] [--extendcubes VAR] [--cuberesolve VAR] [--cubeflp VAR] [--smallcubedisable VAR] [--tdwrstdecay VAR] [--threads VAR] [--bitsjobs VAR] [--debugthreads VAR] [--mpfrprec VAR] inputfile

Positional arguments:
  inputfile                input CNF [nargs: 0 or more] 

Optional arguments:
  -h, --help               shows help message and exits 
  -v, --verb               Verbosity [nargs=0..1] [default: 1]
  -s, --seed               Seed [nargs=0..1] [default: 0]
  -v, --version            Print version and exit 
  --mode                   0=integer counting,
                           1=weighted counting over the rationals,
                           2=complex rational numbers,
                           3=multivariate polynomials over the rational field,
                           4=parity counting,
                           5=counting over a prime field (see --prime),
                           6=mpfr floating point complex numbers (see --mpfrprec),
                           7=mpfr floating point real numbers (see --mpfrprec),
                           13=multivariate Laurent polynomials over the rational field (see --npolyvars)
 [nargs=0..1] [default: 0]
  --prime                  Prime for prime field counting [nargs=0..1] [default: -1]
  --npolyvars              Number of variables in the polynomial field [nargs=0..1] [default: -1]
  --delta                  Delta [nargs=0..1] [default: 0.2]
  --appmct                 after K seconds [nargs=0..1] [default: -1]
  --epsilon                AppMC epsilon [nargs=0..1] [default: 0.8]
  --chronobt               ChronoBT. SAT must be DISABLED or this will fail [nargs=0..1] [default: 1]
  --prob                   Use probabilistic hashing. When set to 0, we are not running in probabilistic mode, but in deterministic mode, i.e. delta is 0 in Ganak mode (not in case we switch to ApproxMC mode via --appmct) [nargs=0..1] [default: 1]
  --fast                   Optimize for quick/easy instances (<5 mins) 
  --compile                Compile the search trace into a (Decision-)d-DNNF circuit and write it to this file (d4 .nnf format). Forces a clean single-threaded search (no restarts, exact cache, no BuDDy/vivify, no Arjun/Puura). SAT oracle stays on (witnesses synthesized vars on projected inputs). [nargs=0..1] [default: ""]
  --arjun                  Use arjun [nargs=0..1] [default: 1]
  --arjunverb              Arjun verb [nargs=0..1] [default: 1]
  --arjungates             Use arjun's gate detection [nargs=0..1] [default: 1]
  --arjunextend            Extend indep via Arjun's extend system [nargs=0..1] [default: true]
  --prebackbone            Perform backbone before other things [nargs=0..1] [default: 0]
  --puura                  Run Puura [nargs=0..1] [default: 1]
  --puurabackbone          Perform backbone in Puura [nargs=0..1] [default: true]
  --puurabackbonemaxconfl  Max conflicts for backbone in Puura (-1 = unlimited) [nargs=0..1] [default: -1]
  --puuraautarky           Do autarky in Puura [nargs=0..1] [default: true]
  --arjuniter1             Arjun's iter1 [nargs=0..1] [default: 2]
  --arjuniter2             Arjun's iter2 [nargs=0..1] [default: 2]
  --arjunprobe             Probe based arjun [nargs=0..1] [default: 1]
  --arjunsimplev           Arjun simp level [nargs=0..1] [default: 2]
  --arjunbackwmaxc         Arjun backw max confl [nargs=0..1] [default: 20000]
  --arjunoraclefindbins    Arjun's oracle should find bins or not [nargs=0..1] [default: 6]
  --arjunoraclemult        Multiplier for Arjun's oracle timeout when it is called from Puura [nargs=0..1] [default: 1]
  --puuraoraclevivif       Run Puura's main oracle vivification pass [nargs=0..1] [default: true]
  --puuraoraclesparsify    Run Puura's main oracle sparsification pass [nargs=0..1] [default: true]
  --puurabve               Run BVE in Puura [nargs=0..1] [default: true]
  --bveresolvmaxsz         Puura BVE max resolvent size in literals. -1 == no limit [nargs=0..1] [default: 12]
  --bvegrowiter1           Puura BVE growth allowance iter1 [nargs=0..1] [default: 0]
  --bvegrowiter2           Puura BVE growth allowance iter2 [nargs=0..1] [default: 6]
  --extraoracle            Extra oracle at the end of puura [nargs=0..1] [default: true]
  --resolvsub              Sets relevant CMS option: subsume other clauses with resolvent clauses [nargs=0..1] [default: 1]
  --arjunoraclegetlearnt   Arjun's oracle should get learnts [nargs=0..1] [default: true]
  --arjundebugcnf          Write debug arjun CNF into this file [nargs=0..1] [default: ""]
  --arjuncmsmult           Pass this multiplier to CMSat through Arjun [nargs=0..1] [default: -1]
  --arjunsamplcutoff       Only perform further arjun-based minimization in case the minimized indep support is larger or equal to this [nargs=0..1] [default: 10]
  --arjunextendccnr        Filter extend of ccnr gates via CCNR mems, in the millions [nargs=0..1] [default: 0]
  --arjunweakenlim         Arjun's weaken limitation [nargs=0..1] [default: 8000]
  --puurastrategy          Puura iter1 simplification strategy: 0=default, 1=new-model [nargs=0..1] [default: 1]
  --td                     Run TD decompose [nargs=0..1] [default: 1]
  --tdmaxw                 TD max weight [nargs=0..1] [default: 60]
  --tdminw                 TD min weight [nargs=0..1] [default: 7]
  --tddiv                  TD divider [nargs=0..1] [default: 1000]
  --tdexpmult              TD exponential multiplier [nargs=0..1] [default: 1.1]
  --tdcheckagainstind      Check TD against indep size [nargs=0..1] [default: 1]
  --tditers                TD flowcutter iterations (restarts) [nargs=0..1] [default: 900]
  --tdsteps                TD flowcutter number of steps at most [nargs=0..1] [default: 100000]
  --tdlook                 -1 means never [nargs=0..1] [default: -1]
  --tdlooktwcut            TD lookahead only when TW of current comp is larger than this value [nargs=0..1] [default: 26]
  --tdlookiters            TD lookahead iterations [nargs=0..1] [default: 10]
  --tdcontract             TD contract over opt indep set [nargs=0..1] [default: 1]
  --tdlimit                If TD is over this, reduce weight to 0.1 [nargs=0..1] [default: 100000]
  --tdoptindep             Use opt indep for TD computation [nargs=0..1] [default: 1]
  --tdmaxdensity           Max density for TD computation [nargs=0..1] [default: 0.3]
  --tdmaxedgeratio         Max edge to var ratio for TD computation [nargs=0..1] [default: 30]
  --tduseadj               TD should use adjacency matrix for computing TD scores [nargs=0..1] [default: 1]
  --tdreadfile             Read TD scores from this file [nargs=0..1] [default: ""]
  --tdvis                  Visualize the TD into this file in DOT format [nargs=0..1] [default: ""]
  --tddumpcnf              Dump the CNF used to build the primal graph for TD computation into this file (DIMACS) [nargs=0..1] [default: ""]
  --rdbclstarget           RDB clauses target size (added to this are LBD 3 or lower) [nargs=0..1] [default: 10000]
  --rdbeveryn              Reduce the clause DB every N conflicts [nargs=0..1] [default: 10000]
  --rdbkeepused            RDB keeps clauses that are used [nargs=0..1] [default: 0]
  --consolidateeveryn      Consolidate memory after every N learnt clause [nargs=0..1] [default: 30000]
  --lbd                    Initial LBD cutoff [nargs=0..1] [default: 2]
  --updatelbdcutoff        Update lbd cutoff [nargs=0..1] [default: 0]
  --polar                  0=standard_polarity, 1=polar cache, 2=false, 3=true [nargs=0..1] [default: 0]
  --decide                 ignore or not ignore TD [nargs=0..1] [default: 0]
  --initact                Init activity scores to var freq [nargs=0..1] [default: 1]
  --vsadsadjust            VSADS ajust activity every N [nargs=0..1] [default: 256]
  --actscorediv            Activity score divisor [nargs=0..1] [default: 3]
  --freqscorediv           Component frequency score divisor [nargs=0..1] [default: 25]
  --cache                  Use (i.e. store and retrieve) cache [nargs=0..1] [default: 1]
  --maxcache               Max cache size in MB [nargs=0..1] [default: 2500]
  --cachetime              2 = set to mid-point [nargs=0..1] [default: 2]
  --lru                    Cache eviction: 1 = LRU (evict oldest), 0 = reverse-LRU/default (evict newest) [nargs=0..1] [default: 0]
  --buddy                  Run BuDDy [nargs=0..1] [default: 0]
  --buddymaxcls            Run BuDDy [nargs=0..1] [default: 6]
  --shrink                 Block-wise secondary UIP shrinking (CaDiCaL-style) [nargs=0..1] [default: 1]
  --bumpreason             Bump reason clause literals during conflict analysis (CaDiCaL-style) [nargs=0..1] [default: 1]
  --vivif                  Vivify clauses [nargs=0..1] [default: 1]
  --vivifevery             Vivify every N conflicts [nargs=0..1] [default: 60000]
  --vivifmult              How much to multiply timeout for vivif [nargs=0..1] [default: 1]
  --vivifoutern            How many restarts between outer vivif [nargs=0..1] [default: 1]
  --totusedcutoffvivif     Total used vivif cutoff [nargs=0..1] [default: 50]
  --sbvasteps              SBVA steps. 0 = no SBVA [nargs=0..1] [default: 1000]
  --sbvaclcut              SBVA cls cutoff [nargs=0..1] [default: 4]
  --sbvalitcut             SBVA lits cutoff [nargs=0..1] [default: 5]
  --sbvabreak              1 = sbva [nargs=0..1] [default: 1]
  --sbvamaxnewvars         Max number of new variables SBVA may add. 0 = no limit [nargs=0..1] [default: 1000]
  --satsolver              Use SAT solver when all minimal indep set has been set [nargs=0..1] [default: 1]
  --satrst                 Inside SAT solver, perform restarts [nargs=0..1] [default: 1]
  --satrstmult             SAT restart multiplier [nargs=0..1] [default: 300]
  --satpolarcache          Inside SAT solver, use polarity cache [nargs=0..1] [default: 1]
  --satvsids               Inside SAT solver, use VSIDS, not VSADS [nargs=0..1] [default: 1]
  --allindep               All variables can be made part of the indepedent support. Indep support is given ONLY to help the solver. [nargs=0..1] [default: false]
  --arjunextendmaxconfl    Max number of conflicts per extend operation in Arjun [nargs=0..1] [default: 30000]
  --arjunextend            Max number of conflicts per extend operation in Arjun [nargs=0..1] [default: true]
  --stripoptindep          Strip optional indep support [nargs=0..1] [default: 0]
  --analyzecand            Update analyze candidates if more than N vars are still undecided from opt indep set [nargs=0..1] [default: 50]
  --rstfirst               Run restarts [nargs=0..1] [default: 20000]
  --restart                Run restarts [nargs=0..1] [default: 0]
  --rsttype                Check count at every step [nargs=0..1] [default: 7]
  --rstcheckcnt            Check the count of each cube. 1 = use ganak itself without restart. 2 = use CMS one-by-one counting [nargs=0..1] [default: 0]
  --rstreadjust            Readjust params for restart [nargs=0..1] [default: 1]
  --maxrst                 Max number of restarts [nargs=0..1] [default: -1]
  --maxcubesperrst         Max number of cubes per restart [nargs=0..1] [default: 6]
  --extendcubes            Extend cubes [nargs=0..1] [default: 1]
  --cuberesolve            Resolution-merge cubes that differ in exactly one blocking literal [nargs=0..1] [default: 1]
  --cubeflp                Failed-literal probing to remove forced blocking literals from cubes [nargs=0..1] [default: 1]
  --smallcubedisable       Disable cubes beyond max-num-cubes-per-restart (sorted by LBD) [nargs=0..1] [default: 1]
  --tdwrstdecay            Multiply td_weight by this after each restart (1.0=no decay, 0.5=halve) [nargs=0..1] [default: 0.5]
  --threads                Number of threads to use. -1 = all available cores [nargs=0..1] [default: 1]
  --bitsjobs               Number of variables to multi-thread on (8 = 256 jobs) [nargs=0..1] [default: 10]
  --debugthreads           Debug threads -- use thread system, even though only one thread is allowed [nargs=0..1] [default: 0]
  --mpfrprec               MPFR precision in bits [nargs=0..1] [default: 64]
