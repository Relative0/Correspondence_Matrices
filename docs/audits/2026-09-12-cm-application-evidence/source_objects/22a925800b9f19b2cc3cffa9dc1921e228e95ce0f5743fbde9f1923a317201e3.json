[
  {
    "name": "mechanism-tests",
    "args": [
      "-m",
      "pytest",
      "tests/test_projected_simplify.py",
      "tests/test_attributed_feature_projection.py",
      "-q",
      "-p",
      "no:cacheprovider",
      "--junitxml",
      "/workspace/cm-packed-evidence/MECHANISM-TESTS.xml"
