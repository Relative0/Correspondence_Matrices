{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "release_id": {
      "type": "string",
      "minLength": 1
    },
    "episode_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "draft",
        "qa_passed",
        "approved",
        "published"
      ]
    },
    "inputs": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "chapters": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "chapter_id": {
            "type": "string",
            "minLength": 1
          },
          "video": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "path",
              "sha256"
            ]
          },
          "audio": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "path",
              "sha256"
            ]
          },
          "duration_s": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "chapter_id",
          "video",
          "audio",
          "duration_s"
        ]
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "video": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ]
        },
        "captions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ]
        },
        "audio_master": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ]
        }
      },
      "required": [
        "video",
        "captions",
        "audio_master"
      ]
    },
    "qa": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "duration_in_range": {
          "type": "boolean"
        },
        "chapter_count_matches": {
          "type": "boolean"
        },
        "video_contract_passed": {
          "type": "boolean"
        },
        "audio_contract_passed": {
          "type": "boolean"
        },
        "caption_contract_passed": {
          "type": "boolean"
        },
        "all_hashes_verified": {
          "type": "boolean"
        },
        "passed": {
          "type": "boolean"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "duration_in_range",
        "chapter_count_matches",
        "video_contract_passed",
        "audio_contract_passed",
        "caption_contract_passed",
        "all_hashes_verified",
        "passed",
        "notes"
      ]
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "schema_version",
    "release_id",
    "episode_id",
    "created_at",
    "status",
    "inputs",
    "chapters",
    "outputs",
    "qa",
    "content_hash"
  ]
}
