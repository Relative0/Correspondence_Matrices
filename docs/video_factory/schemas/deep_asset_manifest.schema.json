{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "video_id": {
      "type": "string",
      "minLength": 1
    },
    "episode_content_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "asset_id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "source_or_license": {
            "type": "string",
            "minLength": 1
          },
          "width": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "height": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "generator": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "asset_id",
          "path",
          "kind",
          "source_or_license",
          "width",
          "height",
          "sha256",
          "generator"
        ]
      }
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "schema_version",
    "video_id",
    "episode_content_hash",
    "assets",
    "content_hash"
  ]
}
