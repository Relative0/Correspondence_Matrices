{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "job_id": {
      "type": "string",
      "minLength": 1
    },
    "cache_identity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "status": {
      "enum": [
        "passed",
        "failed"
      ]
    },
    "outputs": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "technical_observations": {
      "type": "object"
    },
    "preview_frame_hashes": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "passed": {
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "job_id",
    "cache_identity",
    "status",
    "outputs",
    "technical_observations",
    "preview_frame_hashes",
    "warnings",
    "passed"
  ]
}
