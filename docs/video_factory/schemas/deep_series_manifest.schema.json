{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "status": {
      "const": "review_candidate"
    },
    "bible_content_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "episode_count": {
      "const": 51
    },
    "ordered_episode_ids": {
      "type": "array",
      "minItems": 51,
      "maxItems": 51,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "section_id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "episode_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "required": [
          "section_id",
          "title",
          "episode_ids"
        ]
      }
    },
    "episode_contract_hashes": {
      "type": "object",
      "minProperties": 51,
      "maxProperties": 51,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "schema_version",
    "status",
    "bible_content_hash",
    "episode_count",
    "ordered_episode_ids",
    "sections",
    "episode_contract_hashes",
    "content_hash"
  ]
}
