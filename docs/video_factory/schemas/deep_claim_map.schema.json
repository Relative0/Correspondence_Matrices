{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "video_id": {
      "type": "string",
      "minLength": 1
    },
    "episode_content_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "cue_id": {
            "type": "string",
            "minLength": 1
          },
          "scene_id": {
            "type": "string",
            "minLength": 1
          },
          "text_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "evidence_status": {
            "type": "string",
            "minLength": 1
          },
          "conceptual": {
            "type": "boolean"
          },
          "claims": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "claim_id": {
                  "type": "string",
                  "minLength": 1
                },
                "allowed_wording": {
                  "type": "string",
                  "minLength": 1
                },
                "type": {
                  "type": "string",
                  "minLength": 1
                },
                "status": {
                  "type": "string",
                  "minLength": 1
                },
                "scope": {
                  "type": "string",
                  "minLength": 1
                },
                "measurement_boundary": {
                  "type": "string"
                },
                "comparator": {
                  "type": "string"
                },
                "ratio_direction": {
                  "type": "string"
                },
                "uncertainty": {
                  "type": "string"
                },
                "sources": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "source_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "path": {
                        "type": "string",
                        "minLength": 1
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      },
                      "locator": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "source_id",
                      "path",
                      "sha256",
                      "locator"
                    ]
                  }
                }
              },
              "required": [
                "claim_id",
                "allowed_wording",
                "type",
                "status",
                "scope",
                "measurement_boundary",
                "comparator",
                "ratio_direction",
                "uncertainty",
                "sources"
              ]
            }
          }
        },
        "required": [
          "cue_id",
          "scene_id",
          "text_sha256",
          "evidence_status",
          "conceptual",
          "claims"
        ]
      }
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "schema_version",
    "video_id",
    "episode_content_hash",
    "bindings",
    "content_hash"
  ]
}
