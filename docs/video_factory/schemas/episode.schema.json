{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "episode_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "promise": {
      "type": "string",
      "minLength": 1
    },
    "audience": {
      "type": "string",
      "minLength": 1
    },
    "target_duration_s": {
      "type": "number",
      "minimum": 360,
      "maximum": 480
    },
    "actual_duration_s": {
      "type": [
        "number",
        "null"
      ],
      "exclusiveMinimum": 0
    },
    "format": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "width": {
          "type": "integer",
          "minimum": 640
        },
        "height": {
          "type": "integer",
          "minimum": 360
        },
        "fps": {
          "type": "integer",
          "minimum": 24,
          "maximum": 60
        },
        "video_codec": {
          "const": "h264"
        },
        "pixel_format": {
          "const": "yuv420p"
        },
        "audio_codec": {
          "const": "aac"
        }
      },
      "required": [
        "name",
        "width",
        "height",
        "fps",
        "video_codec",
        "pixel_format",
        "audio_codec"
      ]
    },
    "claim_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "chapters": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "chapter_id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "chapter_id",
          "path",
          "sha256"
        ]
      }
    },
    "narration_contract": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ]
    },
    "caption_contract": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ]
    },
    "release_manifest_path": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "draft",
        "planned",
        "rendered",
        "passed",
        "released"
      ]
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "schema_version",
    "episode_id",
    "title",
    "promise",
    "audience",
    "target_duration_s",
    "actual_duration_s",
    "format",
    "claim_ids",
    "source_ids",
    "chapters",
    "narration_contract",
    "caption_contract",
    "release_manifest_path",
    "status",
    "content_hash"
  ]
}
