{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "episode_id": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "type": "string",
      "minLength": 1
    },
    "format": {
      "const": "webvtt"
    },
    "delivery": {
      "enum": [
        "sidecar",
        "burned_in",
        "both"
      ]
    },
    "readability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_characters_per_line": {
          "type": "integer",
          "minimum": 24,
          "maximum": 60
        },
        "max_lines": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "minimum_display_s": {
          "type": "number",
          "minimum": 0.5
        }
      },
      "required": [
        "max_characters_per_line",
        "max_lines",
        "minimum_display_s"
      ]
    },
    "cues": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "cue_id": {
            "type": "string",
            "minLength": 1
          },
          "chapter_id": {
            "type": "string",
            "minLength": 1
          },
          "scene_id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "start_s": {
            "type": "number",
            "minimum": 0
          },
          "end_s": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "cue_id",
          "chapter_id",
          "scene_id",
          "text",
          "start_s",
          "end_s"
        ]
      }
    },
    "status": {
      "enum": [
        "planned",
        "rendered",
        "approved"
      ]
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "schema_version",
    "episode_id",
    "language",
    "format",
    "delivery",
    "readability",
    "cues",
    "status",
    "content_hash"
  ]
}
