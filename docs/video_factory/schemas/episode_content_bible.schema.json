{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "status": {
      "const": "proposed"
    },
    "generated_date": {
      "type": "string",
      "minLength": 1
    },
    "baseline_episode_count": {
      "const": 51
    },
    "sections": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "section_id": {
            "type": "string",
            "minLength": 1
          },
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "episode_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "required": [
          "section_id",
          "order",
          "title",
          "purpose",
          "episode_ids"
        ]
      }
    },
    "stable_examples": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "example_id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "definition": {
            "type": "string",
            "minLength": 1
          },
          "conceptual": {
            "type": "boolean"
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "required": [
          "example_id",
          "title",
          "purpose",
          "definition",
          "conceptual",
          "source_ids"
        ]
      }
    },
    "dialogue_rules": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "approval_gate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required": {
          "const": true
        },
        "separate_from_runpod_authorization": {
          "const": true
        },
        "status": {
          "enum": [
            "not_requested",
            "review_requested",
            "changes_requested",
            "approved",
            "stale"
          ]
        },
        "required_artifact_types": {
          "type": "array",
          "minItems": 6,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "review_manifest_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "approved_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "approved_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "approval_identity": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "required",
        "separate_from_runpod_authorization",
        "status",
        "required_artifact_types",
        "review_manifest_sha256",
        "approved_by",
        "approved_at",
        "approval_identity"
      ]
    },
    "episodes": {
      "type": "array",
      "minItems": 51,
      "maxItems": 51,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "video_id": {
            "type": "string",
            "minLength": 1
          },
          "section_id": {
            "type": "string",
            "minLength": 1
          },
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "audience": {
            "type": "string",
            "minLength": 1
          },
          "duration_tier": {
            "enum": [
              "focused_explainer",
              "core_episode",
              "deep_episode"
            ]
          },
          "duration_minutes": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "minimum": {
                "type": "number",
                "minimum": 1
              },
              "maximum": {
                "type": "number",
                "minimum": 1
              }
            },
            "required": [
              "minimum",
              "maximum"
            ]
          },
          "prerequisite_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "thesis": {
            "type": "string",
            "minLength": 1
          },
          "owns": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "references": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "excludes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "definitions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "claim_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "worked_example_id": {
            "type": "string",
            "minLength": 1
          },
          "teaching_beats": {
            "type": "array",
            "minItems": 6,
            "maxItems": 10,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "visual_spine": {
            "type": "array",
            "minItems": 3,
            "maxItems": 8,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "chapter_plan": {
            "type": "array",
            "minItems": 3,
            "maxItems": 5,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "chapter_id": {
                  "type": "string",
                  "pattern": "^c[0-9]{2}$"
                },
                "working_title": {
                  "type": "string",
                  "minLength": 1
                },
                "purpose": {
                  "type": "string",
                  "minLength": 1
                },
                "teaching_beat_numbers": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "uniqueItems": true
                },
                "visual_spine_indices": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "uniqueItems": true
                }
              },
              "required": [
                "chapter_id",
                "working_title",
                "purpose",
                "teaching_beat_numbers",
                "visual_spine_indices"
              ]
            }
          },
          "visual_contract": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "minimum_distinct_compositions": {
                "type": "integer",
                "minimum": 1
              },
              "minimum_meaningful_state_changes": {
                "type": "integer",
                "minimum": 1
              },
              "required_asset_kinds": {
                "type": "array",
                "minItems": 5,
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "continuity_assets": {
                "type": "array",
                "minItems": 3,
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "external_imagery_policy": {
                "type": "string",
                "minLength": 1
              },
              "progression_rule": {
                "type": "string",
                "minLength": 1
              },
              "forbidden_shortcuts": {
                "type": "array",
                "minItems": 3,
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            },
            "required": [
              "minimum_distinct_compositions",
              "minimum_meaningful_state_changes",
              "required_asset_kinds",
              "continuity_assets",
              "external_imagery_policy",
              "progression_rule",
              "forbidden_shortcuts"
            ]
          },
          "dialogue_anchors": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "hook": {
                "type": "string",
                "minLength": 1
              },
              "definition": {
                "type": "string",
                "minLength": 1
              },
              "boundary": {
                "type": "string",
                "minLength": 1
              },
              "closing": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "hook",
              "definition",
              "boundary",
              "closing"
            ]
          },
          "retrieval_check": {
            "type": "string",
            "minLength": 1
          },
          "closing_takeaway": {
            "type": "string",
            "minLength": 1
          },
          "misconceptions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "caveats": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "content_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "video_id",
          "section_id",
          "order",
          "title",
          "audience",
          "duration_tier",
          "duration_minutes",
          "prerequisite_ids",
          "thesis",
          "owns",
          "references",
          "excludes",
          "definitions",
          "claim_ids",
          "source_ids",
          "worked_example_id",
          "teaching_beats",
          "visual_spine",
          "chapter_plan",
          "visual_contract",
          "dialogue_anchors",
          "retrieval_check",
          "closing_takeaway",
          "misconceptions",
          "caveats",
          "content_hash"
        ]
      }
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "schema_version",
    "status",
    "generated_date",
    "baseline_episode_count",
    "sections",
    "stable_examples",
    "dialogue_rules",
    "approval_gate",
    "episodes",
    "content_hash"
  ]
}
