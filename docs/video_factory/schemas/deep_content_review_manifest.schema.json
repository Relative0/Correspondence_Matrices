{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "status": {
      "const": "review_requested"
    },
    "bible_content_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "episode_count": {
      "const": 51
    },
    "artifact_count": {
      "type": "integer",
      "minimum": 1
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "hash_scope": {
            "type": "string",
            "minLength": 1
          },
          "artifact_type": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "path",
          "sha256",
          "hash_scope",
          "artifact_type"
        ]
      }
    },
    "unresolved_editorial_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "question": {
            "type": "string",
            "minLength": 1
          },
          "affected_episode_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "required": [
          "question",
          "affected_episode_ids"
        ]
      }
    },
    "review_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "schema_version",
    "status",
    "bible_content_hash",
    "episode_count",
    "artifact_count",
    "artifacts",
    "unresolved_editorial_questions",
    "review_manifest_sha256"
  ]
}
