{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "generated_date": {
      "type": "string",
      "minLength": 1
    },
    "repository_head": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "current",
              "accepted",
              "reference",
              "superseded"
            ]
          },
          "date": {
            "type": "string",
            "minLength": 1
          },
          "supersedes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "superseded_by": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "path",
          "sha256",
          "type",
          "status",
          "date",
          "supersedes",
          "superseded_by"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "generated_date",
    "repository_head",
    "sources"
  ]
}
