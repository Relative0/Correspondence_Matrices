# Reproducible build/test workspaces and Python caches.
/tmp/
**/__pycache__/
*.py[cod]

# Frozen RunPod packages and downloaded remote workspaces are reconstructed
# from the checked-in manifests, controller, and source tree.
/runpod/dist/
/runpod/remote/

# Long-form masters and chapter caches stay local; their release manifest and
# content hashes are versioned beside the episode contracts.
/episodes/*/output/

# IVC keeps raw and per-shot intermediates below work/. The encoded proof,
# timeline, reports, observations, and preview frames remain versioned.
/proofs/*/ivc-output/*/work/
