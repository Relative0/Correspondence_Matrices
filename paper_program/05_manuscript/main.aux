\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces A binary truth value is encoded as a true-first bra or ket, and $[\Theta ]$ acts between them through XOR--AND contraction. The XOR CM $[\mathbin {\Updownarrow }]$ is a $90^\circ $ rotation and entrywise complement of the XNOR CM $[\Leftrightarrow ]$. Their entrywise Boolean superposition is the tautological Impax CM $[\mathrel {\mathchoice {\setbox \impax@lr \hbox {$\mathsurround \z@ \displaystyle \Leftrightarrow $}\setbox \impax@ud \hbox {$\mathsurround \z@ \displaystyle \Updownarrow $}\hbox {\copy \impax@lr \kern -\wd \impax@lr \hbox to\wd \impax@lr {\hss \kern 0pt\raise 0pt\box \impax@ud \hss }}}{\setbox \impax@lr \hbox {$\mathsurround \z@ \textstyle \Leftrightarrow $}\setbox \impax@ud \hbox {$\mathsurround \z@ \textstyle \Updownarrow $}\hbox {\copy \impax@lr \kern -\wd \impax@lr \hbox to\wd \impax@lr {\hss \kern 0pt\raise 0pt\box \impax@ud \hss }}}{\setbox \impax@lr \hbox {$\mathsurround \z@ \scriptstyle \Leftrightarrow $}\setbox \impax@ud \hbox {$\mathsurround \z@ \scriptstyle \Updownarrow $}\hbox {\copy \impax@lr \kern -\wd \impax@lr \hbox to\wd \impax@lr {\hss \kern 0pt\raise 0pt\box \impax@ud \hss }}}{\setbox \impax@lr \hbox {$\mathsurround \z@ \scriptscriptstyle \Leftrightarrow $}\setbox \impax@ud \hbox {$\mathsurround \z@ \scriptscriptstyle \Updownarrow $}\hbox {\copy \impax@lr \kern -\wd \impax@lr \hbox to\wd \impax@lr {\hss \kern 0pt\raise 0pt\box \impax@ud \hss }}}}]$.}}{4}{figure.1}\protected@file@percent }
\newlabel{fig:cm-evaluation}{{1}{4}{A binary truth value is encoded as a true-first bra or ket, and $\CM {\Theta }$ acts between them through XOR--AND contraction. The XOR CM $\CM {\XOR }$ is a $90^\circ $ rotation and entrywise complement of the XNOR CM $\CM {\Leftrightarrow }$. Their entrywise Boolean superposition is the tautological Impax CM $\CM {\impax }$}{figure.1}{}}
\newlabel{fig:cm-evaluation@cref}{{[figure][1][]1}{[1][3][]4}}
